var ADMIN_PIN='ADMIN2026';function doGet(e){var p=e.parameter||{};try{if(p.action==='results')return jsonp(p.callback,results(p));if(p.action==='getParticipant')return jsonp(p.callback,getParticipant(p));return jsonp(p.callback,{ok:false,error:'Unknown action'})}catch(err){return jsonp(p.callback,{ok:false,error:String(err)})}}function doPost(e){try{var p=e.parameter||{};if(p.action==='save'){save(p);return json({ok:true})}return json({ok:false,error:'Unknown action'})}catch(err){return json({ok:false,error:String(err)})}}function jsonp(cb,obj){cb=String(cb||'callback').replace(/[^a-zA-Z0-9_.$]/g,'');return ContentService.createTextOutput(cb+'('+JSON.stringify(obj)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}function json(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}function check(pin){if(String(pin||'')!==ADMIN_PIN)throw new Error('Invalid admin PIN')}function ss(){var s=SpreadsheetApp.getActiveSpreadsheet();ensure(s);return s}function ensure(s){var sum=s.getSheetByName('Summary')||s.insertSheet('Summary');var rsp=s.getSheetByName('Responses')||s.insertSheet('Responses');if(sum.getLastRow()===0)sum.appendRow(['Participant ID','Name','Score','Answered','Correct','Status','Full State JSON','Started At','Updated At']);if(rsp.getLastRow()===0)rsp.appendRow(['Participant ID','Name','Question ID','Selected Option','Correct','Points','Updated At']);sum.getRange(1,1,1,sum.getLastColumn()).setFontWeight('bold');rsp.getRange(1,1,1,rsp.getLastColumn()).setFontWeight('bold')}function rowFor(sh,id){var n=sh.getLastRow();if(n<2)return null;var v=sh.getRange(2,1,n-1,1).getValues();for(var i=0;i<v.length;i++)if(String(v[i][0]).toUpperCase()===id)return i+2;return null}function save(p){check(p.pin);var id=String(p.participantId||'').toUpperCase();if(!id)throw new Error('Participant ID required');var st=JSON.parse(p.state||'{}');var answers=st.answers||{};var correct=0,answered=0;for(var k in answers){if(answers.hasOwnProperty(k)){answered++;if(answers[k].correct)correct++}}var s=ss(),sum=s.getSheetByName('Summary'),row=[id,p.name||st.name||'',Number(st.score||0),answered,correct,st.complete?'Complete':'In progress',JSON.stringify(st),st.startedAt||'',new Date()];var r=rowFor(sum,id);if(r)sum.getRange(r,1,1,row.length).setValues([row]);else sum.appendRow(row);var rsp=s.getSheetByName('Responses');var existing=rsp.getLastRow()>1?rsp.getRange(2,1,rsp.getLastRow()-1,7).getValues():[];var keep=[];for(var i=0;i<existing.length;i++)if(String(existing[i][0]).toUpperCase()!==id)keep.push(existing[i]);for(var q in answers){if(answers.hasOwnProperty(q)){var a=answers[q];keep.push([id,p.name||st.name||'',Number(q),Number(a.selected)+1,Boolean(a.correct),Number(a.points||0),new Date()])}}if(rsp.getLastRow()>1)rsp.getRange(2,1,rsp.getLastRow()-1,7).clearContent();if(keep.length)rsp.getRange(2,1,keep.length,7).setValues(keep);SpreadsheetApp.flush()}function getParticipant(p){check(p.pin);var id=String(p.participantId||'').toUpperCase(),sh=ss().getSheetByName('Summary'),r=rowFor(sh,id);return{ok:true,state:r?sh.getRange(r,7).getValue():null}}function results(p){check(p.pin);var sh=ss().getSheetByName('Summary'),n=sh.getLastRow();if(n<2)return{ok:true,results:[]};var v=sh.getRange(2,1,n-1,9).getValues(),out=[];for(var i=0;i<v.length;i++)if(v[i][0])out.push({participantId:v[i][0],name:v[i][1],score:v[i][2],answered:v[i][3],correct:v[i][4],status:v[i][5],updatedAt:v[i][8]?new Date(v[i][8]).toISOString():''});return{ok:true,results:out}}